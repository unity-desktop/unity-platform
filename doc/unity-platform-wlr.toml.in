[library]
name = "UnityPlatformWlr"
version = "@VERSION@"
description = "wlroots protocol wrappers for toplevel and output power management."
dependencies = ["GObject-2.0", "Gio-2.0", "AstalWl-0.1"]
devhelp = true
search_index = true
website_url = "https://unity-desktop.github.io/unity-platform/unity-platform-wlr/"
repository_url = "https://github.com/unity-desktop/unity-platform.git"
browse_url = "https://github.com/unity-desktop/unity-platform/tree/main/"

[dependencies."GObject-2.0"]
name = "GObject"
description = "The base type system library"
docs_url = "https://docs.gtk.org/gobject/"

[dependencies."Gio-2.0"]
name = "Gio"
description = "GLib I/O and D-Bus support library"
docs_url = "https://docs.gtk.org/gio/"

[dependencies."AstalWl-0.1"]
name = "AstalWl"
description = "Wayland integration helpers"
docs_url = "https://aylur.github.io/libastal/"

[theme]
name = "basic"
show_index_summary = true
show_class_hierarchy = true

[source-location]
base_url = "https://github.com/unity-desktop/unity-platform/blob/main/wlr/"

[extra]
urlmap_file = "urlmap.js"
